# ==============================================================================
# PaperPulse AI - Environment Configuration
# ==============================================================================
# NOTE: All API keys are 100% OPTIONAL. The system runs offline immediately
# using local sentence-transformers (all-MiniLM-L6-v2) and deterministic
# rule-based peer-review synthesis.
# ==============================================================================

# LLM Providers (Optional - Multi-Provider Fallback Chain)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Active Model & Provider Settings
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Academic Retrieval & Chunking Settings
SECTION_CHUNK_SIZE=500
SECTION_CHUNK_OVERLAP=75
TOP_K_PAPERS=5
CITATION_GRAPH_MAX_HOPS=2
INFLUENTIAL_CITATION_LIMIT=5
SIMILARITY_THRESHOLD=0.35
